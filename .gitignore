# Datos generados de Postgres - NO subir (se regenera solo, pesa 45MB)
postgres-data/

# Archivos temporales de SQLite de n8n - NO subir
n8n-data/*-shm
n8n-data/*-wal
n8n-data/*.shm
n8n-data/*.wal
n8n-data/*.log
n8n-data/crash.journal
n8n-data/n8nEventLog*.log

# Ejecuciones y binarios temporales de n8n
n8n-data/binaryData/
n8n-data/logs/
n8n-data/.cache/

# Configuración y base de datos de n8n: contienen credenciales y datos de ejecución.
# NO se versionan. Se regeneran al levantar el entorno.
n8n-data/database.sqlite
n8n-data/config
n8n-data/

# Artefacto del experimento: estado generado
lab/pgdata/
lab/n8ndata/
lab/runtime/
lab/__pycache__/
__pycache__/
*.pyc

# Documentos de trabajo del informe: no forman parte del artefacto
v3/
